# API Backend URL
VITE_API_URL=http://localhost:3001/api

VITE_ADMIN_EMAIL=soporte@norte.com
VITE_ADMIN_PASSWORD=cambiar-en-produccion

# TODO(limpiar): Eliminar VITE_USE_MOCK cuando el backend esté conectado
# Usar datos mock en memoria mientras no exista el backend real
VITE_USE_MOCK=true

# App
VITE_APP_NAME=NorteProget

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Analytics 4 — Lectura de métricas (Dashboard Admin)
# Client ID de OAuth 2.0 (tipo "Aplicación web"). Es público por diseño, no es un secreto.
VITE_GA_CLIENT_ID=XXXXX.apps.googleusercontent.com
# Property ID numérico de la propiedad GA4 (Admin > Configuración de la propiedad)
VITE_GA_PROPERTY_ID=1234567890

